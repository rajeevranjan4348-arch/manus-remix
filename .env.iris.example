# Configure these in Netlify environment variables, not in VITE_* client variables.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
# Mem0 Platform key enables user-scoped long-term memory. Keep server-side only.
MEM0_API_KEY=
# Optional. Public repository lookup works without this; private repository operations
# must use the app's OAuth connector and explicit approval safeguards.
GITHUB_TOKEN=

# Required only for verified, approval-gated device-command proposals and Mem0 user scoping.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
TOOL_APPROVAL_SECRET=
