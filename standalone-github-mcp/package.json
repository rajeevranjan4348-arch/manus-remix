{
  "name": "cue-github-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Secure GitHub MCP server for Cue using the official TypeScript SDK.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "build:vercel": "next build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:vercel": "next dev",
    "start:vercel": "next start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@octokit/auth-app": "^8.1.0",
    "@octokit/rest": "^21.1.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "firebase-admin": "^14.5.0",
    "mcp-handler": "^2.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
