# Choose "stdio" for local MCP clients or "http" for a persistent hosted MCP service.
MCP_TRANSPORT=stdio
# State-changing tools are omitted by default; enable only with a verified elicitation-capable human approval client.
MCP_ENABLE_WRITE_TOOLS=false
HOST=127.0.0.1
PORT=8080

# Use one GitHub credential method only. Never put these values in Cue client config.
# Fine-grained PAT: grant only required repositories/permissions.
GITHUB_TOKEN=
# Or a GitHub App installation credential (installation token is minted server-side).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Required for hosted HTTP mode. Exact owner/repo allowlist, comma-separated.
GITHUB_ALLOWED_REPOS=owner/repo,owner/another-repo
# Optional: Firebase users allowed to invoke this service (deny-by-default if omitted in HTTP mode).
MCP_ALLOWED_FIREBASE_UIDS=replace-with-firebase-uid
FIREBASE_PROJECT_ID=your-firebase-project-id
# Hosted HTTP mode requires service-account JSON for Firebase ID-token revocation checks.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact HTTP Host names and browser Origins permitted by the service. Do not use '*'.
MCP_ALLOWED_HOSTS=github-mcp.example.com,localhost:8080
MCP_ALLOWED_ORIGINS=https://cue.example.com

# Distributed rate limits for multi-instance production deployments (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Operational limits.
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_SESSIONS=250
MCP_SESSION_TTL_MS=1800000
MCP_RATE_LIMIT_PER_MINUTE=120
GITHUB_REQUEST_TIMEOUT_MS=12000
GITHUB_READ_RETRIES=2
LOG_LEVEL=info
NODE_ENV=development
