rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper for validation of User
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt']) &&
        data.id is string && isValidId(data.id) && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Helper for validation of Settings
    function isValidSettings(data) {
      return data.keys().hasAll(['userId', 'theme']) &&
        data.keys().hasOnly(['userId', 'theme', 'defaultMode', 'language', 'defaultModel', 'voicePersona', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.theme in ['light', 'dark', 'system'] &&
        (!('defaultMode' in data) || data.defaultMode in ['chat', 'work']) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 10)) &&
        (!('defaultModel' in data) || (data.defaultModel is string && data.defaultModel.size() <= 64)) &&
        (!('voicePersona' in data) || data.voicePersona in ['alloy', 'echo', 'fable', 'onyx', 'nova', 'shimmer', 'marcus', 'tintin', 'guy']) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMemories(data) {
      return (!('records' in data) || data.records is list) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSchedules(data) {
      return (!('schedules' in data) || data.schedules is list) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidKnowledgeCache(data) {
      return (!('entries' in data) || data.entries is list) &&
        (!('history' in data) || data.history is list) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Helper for validation of Project
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'description', 'icon', 'color', 'customInstructions', 'created_at', 'updated_at', 'taskIds']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 128 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 64)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 64)) &&
        (!('customInstructions' in data) || (data.customInstructions is string && data.customInstructions.size() <= 10000)) &&
        data.created_at is string && data.created_at.size() <= 64 &&
        data.updated_at is string && data.updated_at.size() <= 64;
    }

    // Helper for validation of Conversation
    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt', 'mode', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt', 'mode', 'outputFormat', 'chartType', 'projectId', 'status', 'result', 'steps', 'prompt', 'messages']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.mode in ['chat', 'work'] &&
        data.status in ['idle', 'running', 'completed', 'error'] &&
        (!('outputFormat' in data) || (data.outputFormat is string && data.outputFormat.size() <= 64)) &&
        (!('chartType' in data) || (data.chartType is string && data.chartType.size() <= 64)) &&
        (!('projectId' in data) || data.projectId == null || (data.projectId is string && isValidId(data.projectId))) &&
        (!('result' in data) || (data.result is string && data.result.size() <= 500000)) &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 10000)) &&
        (!('steps' in data) || data.steps is list) &&
        (!('messages' in data) || data.messages is list);
    }

    function isValidConversationUpdate() {
      return isValidConversation(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (existing().status != 'completed' || (
          incoming().status in ['completed', 'running'] &&
          incoming().title == existing().title &&
          incoming().mode == existing().mode &&
          (!('outputFormat' in existing()) || ('outputFormat' in incoming() && incoming().outputFormat == existing().outputFormat)) &&
          (!('chartType' in existing()) || ('chartType' in incoming() && incoming().chartType == existing().chartType)) &&
          (!('projectId' in existing()) || ('projectId' in incoming() && incoming().projectId == existing().projectId)) &&
          (!('prompt' in existing()) || ('prompt' in incoming() && incoming().prompt == existing().prompt)) &&
          ((incoming().status == 'running' && !('result' in incoming())) ||
            (incoming().status == 'completed' && (!('result' in existing()) || ('result' in incoming() && incoming().result == existing().result)))) &&
          ((incoming().status == 'running' && !('steps' in incoming())) ||
            (incoming().status == 'completed' && (!('steps' in existing()) || ('steps' in incoming() && incoming().steps == existing().steps)))) &&
          (!('messages' in existing()) || ('messages' in incoming() && incoming().messages == existing().messages))
        ));
    }

    // Helper for validation of Message
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp', 'status']) &&
        data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp', 'status', 'error', 'metadata']) &&
        data.id is string && isValidId(data.id) &&
        data.conversationId is string && isValidId(data.conversationId) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.role in ['user', 'assistant', 'system'] &&
        data.content is string && data.content.size() <= 500000 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.status in ['pending', 'success', 'failed', 'streaming'];
    }

    function isValidCheckpoint(data, ownerId, checkpointId) {
      return data.keys().hasAll(['id', 'taskId', 'conversationId', 'userId', 'stepIndex', 'stepLabel', 'completedToolCalls', 'accumulatedResult', 'checksum', 'timestamp']) &&
        data.keys().hasOnly(['id', 'taskId', 'conversationId', 'userId', 'stepIndex', 'totalSteps', 'stepLabel', 'status', 'completedToolCalls', 'accumulatedResult', 'stateSnapshot', 'checksum', 'timestamp', 'resumedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.taskId is string && isValidId(data.taskId) && data.taskId == checkpointId &&
        data.conversationId is string && isValidId(data.conversationId) &&
        data.userId is string && isValidId(data.userId) && data.userId == ownerId &&
        data.stepIndex is int && data.stepIndex >= 0 && data.stepIndex <= 100000 &&
        (!('totalSteps' in data) || (data.totalSteps is int && data.totalSteps >= 0 && data.totalSteps <= 100000)) &&
        data.stepLabel is string && data.stepLabel.size() <= 256 &&
        (!('status' in data) || data.status in ['in_progress', 'completed', 'interrupted', 'failed']) &&
        data.completedToolCalls is list && data.completedToolCalls.size() <= 100 &&
        data.accumulatedResult is string && data.accumulatedResult.size() <= 500000 &&
        (!('stateSnapshot' in data) || (data.stateSnapshot is map && data.stateSnapshot.keys().size() <= 100)) &&
        data.checksum is string && data.checksum.size() <= 128 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        (!('resumedAt' in data) || (data.resumedAt is string && data.resumedAt.size() <= 64));
    }

    function isValidCheckpointTransition() {
      return !('status' in existing()) || !('status' in incoming()) ||
        (existing().status == 'completed' && incoming().status == 'completed') ||
        (existing().status == 'failed' && incoming().status in ['failed', 'completed']) ||
        (existing().status == 'interrupted' && incoming().status in ['interrupted', 'failed', 'completed']) ||
        (existing().status == 'in_progress');
    }

    function isValidSandbox(data, ownerId, sandboxId) {
      return data.keys().hasAll(['sandboxId', 'workspaceId', 'provider', 'providerSandboxId', 'userId', 'projectId', 'runtime', 'workspaceRoot', 'status', 'createdAt', 'updatedAt', 'expiresAt']) &&
        data.keys().hasOnly(['sandboxId', 'workspaceId', 'provider', 'providerSandboxId', 'userId', 'projectId', 'taskId', 'runtime', 'image', 'workspaceRoot', 'status', 'limits', 'persistent', 'previewUrl', 'previewPort', 'previewStatus', 'previewCommandExecutionId', 'createdAt', 'updatedAt', 'lastActiveAt', 'expiresAt', 'cleanedUpAt', 'error']) &&
        data.sandboxId is string && isValidId(data.sandboxId) && data.sandboxId == sandboxId &&
        data.workspaceId is string && isValidId(data.workspaceId) &&
        data.provider in ['e2b', 'daytona', 'http-runtime', 'unconfigured'] &&
        data.providerSandboxId is string && data.providerSandboxId.size() <= 256 &&
        data.userId is string && data.userId == ownerId &&
        data.projectId is string && isValidId(data.projectId) &&
        data.runtime in ['node', 'typescript', 'javascript', 'python', 'html', 'react', 'vite', 'nextjs', 'custom'] &&
        data.workspaceRoot is string && data.workspaceRoot.size() <= 256 &&
        data.status in ['creating', 'running', 'idle', 'stopping', 'stopped', 'expired', 'error'] &&
        (!('limits' in data) || (data.limits is map && data.limits.keys().size() <= 20)) &&
        (!('persistent' in data) || data.persistent is bool) &&
        (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 1024)) &&
        (!('previewPort' in data) || (data.previewPort is int && data.previewPort >= 0 && data.previewPort <= 65535)) &&
        (!('previewStatus' in data) || data.previewStatus in ['stopped', 'starting', 'ready', 'failed']) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.expiresAt is string && data.expiresAt.size() <= 64 &&
        (!('error' in data) || (data.error is string && data.error.size() <= 2000));
    }

    function isValidExecution(data, ownerId, executionId) {
      return data.keys().hasAll(['executionId', 'sandboxId', 'workspaceId', 'userId', 'provider', 'command', 'cwd', 'status', 'startedAt', 'timeoutMs', 'retryCount', 'untrustedData']) &&
        data.keys().hasOnly(['executionId', 'sandboxId', 'workspaceId', 'userId', 'provider', 'providerExecutionId', 'command', 'cwd', 'status', 'stdout', 'stderr', 'exitCode', 'startedAt', 'completedAt', 'durationMs', 'timeoutMs', 'idempotencyKey', 'retryCount', 'cancelled', 'error', 'untrustedData']) &&
        data.executionId is string && isValidId(data.executionId) && data.executionId == executionId &&
        data.sandboxId is string && isValidId(data.sandboxId) &&
        data.workspaceId is string && data.workspaceId.size() <= 128 &&
        data.userId is string && data.userId == ownerId &&
        data.provider in ['e2b', 'daytona', 'http-runtime', 'unconfigured'] &&
        data.command is string && data.command.size() <= 4096 &&
        data.cwd is string && data.cwd.size() <= 512 &&
        data.status in ['queued', 'running', 'completed', 'failed', 'timed_out', 'cancelled'] &&
        (!('stdout' in data) || (data.stdout is string && data.stdout.size() <= 250000)) &&
        (!('stderr' in data) || (data.stderr is string && data.stderr.size() <= 250000)) &&
        (!('exitCode' in data) || data.exitCode == null || data.exitCode is int) &&
        data.startedAt is string && data.startedAt.size() <= 64 &&
        data.timeoutMs is int && data.timeoutMs >= 0 && data.timeoutMs <= 600000 &&
        data.retryCount is int && data.retryCount >= 0 && data.retryCount <= 10 &&
        data.untrustedData == true;
    }

    function isValidBrowserSession(data, ownerId, sessionId) {
      return data.keys().hasAll(['sessionId', 'provider', 'providerSessionId', 'userId', 'status', 'isolatedStorage', 'createdAt', 'updatedAt', 'expiresAt']) &&
        data.keys().hasOnly(['sessionId', 'provider', 'providerSessionId', 'userId', 'projectId', 'taskId', 'status', 'currentUrl', 'currentTitle', 'viewport', 'isolatedStorage', 'createdAt', 'updatedAt', 'lastActiveAt', 'expiresAt', 'closedAt', 'error']) &&
        data.sessionId is string && isValidId(data.sessionId) && data.sessionId == sessionId &&
        data.provider in ['browserless', 'browserbase', 'http-browser', 'unconfigured'] &&
        data.providerSessionId is string && data.providerSessionId.size() <= 256 &&
        data.userId is string && data.userId == ownerId &&
        data.status in ['creating', 'active', 'closed', 'expired', 'error'] &&
        (!('currentUrl' in data) || (data.currentUrl is string && data.currentUrl.size() <= 2048)) &&
        (!('currentTitle' in data) || (data.currentTitle is string && data.currentTitle.size() <= 300)) &&
        (!('viewport' in data) || (data.viewport is map && data.viewport.keys().size() <= 5)) &&
        data.isolatedStorage == true &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.expiresAt is string && data.expiresAt.size() <= 64;
    }

    function isValidApproval(data, ownerId, challengeId) {
      return data.keys().hasAll(['challengeId', 'toolName', 'riskLevel', 'parametersHash', 'userId', 'createdAt', 'expiresAt', 'status']) &&
        data.keys().hasOnly(['challengeId', 'toolName', 'displayName', 'riskLevel', 'target', 'parametersHash', 'parametersSummary', 'consequences', 'userId', 'createdAt', 'expiresAt', 'status', 'approvalToken', 'resolvedAt', 'revokedAt', 'revocationReason']) &&
        data.challengeId is string && isValidId(data.challengeId) && data.challengeId == challengeId &&
        data.toolName is string && data.toolName.size() <= 128 &&
        data.riskLevel in ['read-only', 'destructive', 'privileged'] &&
        data.parametersHash is string && data.parametersHash.size() <= 128 &&
        data.userId is string && data.userId == ownerId &&
        data.createdAt is int && data.expiresAt is int &&
        data.status in ['pending', 'approved', 'rejected', 'expired', 'consumed', 'revoked'] &&
        (!('parametersSummary' in data) || (data.parametersSummary is map && data.parametersSummary.keys().size() <= 30)) &&
        (!('consequences' in data) || (data.consequences is list && data.consequences.size() <= 20)) &&
        (!('revocationReason' in data) || (data.revocationReason is string && data.revocationReason.size() <= 300));
    }

    function isValidPermissionPolicy(data, ownerId, policyId) {
      return data.keys().hasAll(['policyId', 'userId', 'toolName', 'mode', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['policyId', 'userId', 'toolName', 'mode', 'updatedAt', 'updatedBy', 'note']) &&
        data.policyId is string && isValidId(data.policyId) && data.policyId == policyId &&
        data.userId is string && data.userId == ownerId &&
        data.toolName is string && data.toolName.size() <= 128 &&
        data.mode in ['default', 'always_require_approval', 'auto_allow_non_destructive', 'deny'] &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.updatedBy is string && data.updatedBy == ownerId &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300));
    }

    function isValidBackgroundTask(data, ownerId, taskId) {
      return data.keys().hasAll(['taskId', 'userId', 'type', 'title', 'prompt', 'status', 'phase', 'priority', 'attempt', 'maxAttempts', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['taskId', 'userId', 'type', 'title', 'prompt', 'payload', 'status', 'phase', 'priority', 'priorityScore', 'progress', 'idempotencyKey', 'scheduleId', 'attempt', 'maxAttempts', 'baseBackoffMs', 'timeoutMs', 'nextAttemptAt', 'leaseOwner', 'leaseExpiresAt', 'workerDispatchState', 'workerDispatchDetail', 'result', 'error', 'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'cancelledAt', 'history']) &&
        data.taskId is string && isValidId(data.taskId) && data.taskId == taskId &&
        data.userId is string && data.userId == ownerId &&
        data.type in ['research', 'coding', 'automation', 'multi_agent', 'scheduled', 'skill', 'general'] &&
        data.title is string && data.title.size() <= 180 &&
        data.prompt is string && data.prompt.size() <= 20000 &&
        data.status in ['queued', 'claimed', 'running', 'completed', 'failed', 'cancelled', 'dead_letter'] &&
        data.phase is string && data.phase.size() <= 64 &&
        data.priority in ['low', 'normal', 'high', 'urgent'] &&
        data.attempt is int && data.attempt >= 0 && data.attempt <= 20 &&
        data.maxAttempts is int && data.maxAttempts >= 1 && data.maxAttempts <= 10 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('history' in data) || (data.history is list && data.history.size() <= 200));
    }

    function isValidMultiAgentRun(data, ownerId, runId) {
      return data.keys().hasAll(['runId', 'userId', 'objective', 'status', 'provider', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['runId', 'userId', 'objective', 'status', 'provider', 'maxConcurrency', 'maxRecursionDepth', 'maxTotalTokens', 'maxCostUsd', 'timeoutMs', 'nodes', 'qaReview', 'consolidatedAnswer', 'totalUsage', 'error', 'createdAt', 'updatedAt', 'completedAt']) &&
        data.runId is string && isValidId(data.runId) && data.runId == runId &&
        data.userId is string && data.userId == ownerId &&
        data.objective is string && data.objective.size() <= 4000 &&
        data.status in ['running', 'completed', 'failed', 'cancelled'] &&
        data.provider is string && data.provider.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('nodes' in data) || (data.nodes is list && data.nodes.size() <= 30));
    }

    function isValidInstalledSkill(data, ownerId, skillId) {
      return data.keys().hasAll(['skillId', 'userId', 'name', 'version', 'executionType', 'trustTier', 'integrityHash', 'enabled', 'installedAt', 'updatedAt']) &&
        data.keys().hasOnly(['skillId', 'userId', 'name', 'description', 'version', 'instructions', 'supportedTools', 'dependencies', 'permissions', 'compatibility', 'executionType', 'sandboxScript', 'tags', 'trustTier', 'integrityHash', 'enabled', 'config', 'versions', 'installedAt', 'updatedAt']) &&
        data.skillId is string && isValidId(data.skillId) && data.skillId == skillId &&
        data.userId is string && data.userId == ownerId &&
        data.name is string && data.name.size() <= 128 &&
        data.version is string && data.version.size() <= 32 &&
        data.executionType in ['declarative', 'tool_workflow', 'sandbox_code'] &&
        data.trustTier in ['verified_builtin', 'third_party'] &&
        data.integrityHash is string && data.integrityHash.size() <= 128 &&
        data.enabled is bool &&
        data.installedAt is string && data.installedAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('versions' in data) || (data.versions is list && data.versions.size() <= 50));
    }

    function isValidSkillExecution(data, ownerId, executionId) {
      return data.keys().hasAll(['executionId', 'userId', 'skillId', 'skillVersion', 'status', 'startedAt', 'completedAt']) &&
        data.keys().hasOnly(['executionId', 'userId', 'skillId', 'skillVersion', 'executionType', 'status', 'inputSummary', 'output', 'sandboxId', 'error', 'startedAt', 'completedAt', 'durationMs']) &&
        data.executionId is string && isValidId(data.executionId) && data.executionId == executionId &&
        data.userId is string && data.userId == ownerId &&
        data.skillId is string && data.skillId.size() <= 64 &&
        data.skillVersion is string && data.skillVersion.size() <= 32 &&
        data.status in ['succeeded', 'failed', 'denied'] &&
        data.startedAt is string && data.startedAt.size() <= 64 &&
        data.completedAt is string && data.completedAt.size() <= 64;
    }

    function isValidSchedule(data, ownerId, scheduleId) {
      return data.keys().hasAll(['scheduleId', 'userId', 'name', 'kind', 'status', 'timeZone', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['scheduleId', 'userId', 'name', 'description', 'kind', 'status', 'timeZone', 'runAt', 'intervalMinutes', 'timeOfDay', 'dayOfWeek', 'dayOfMonth', 'cronExpression', 'missedJobPolicy', 'maxCatchUpRuns', 'condition', 'taskTemplate', 'notifyOnRun', 'nextRunAt', 'lastRunAt', 'lastRunStatus', 'runCount', 'createdAt', 'updatedAt']) &&
        data.scheduleId is string && isValidId(data.scheduleId) && data.scheduleId == scheduleId &&
        data.userId is string && data.userId == ownerId &&
        data.name is string && data.name.size() <= 160 &&
        data.kind in ['once', 'interval', 'daily', 'weekly', 'monthly', 'cron'] &&
        data.status in ['active', 'paused', 'completed', 'cancelled'] &&
        data.timeZone is string && data.timeZone.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidScheduleRun(data, ownerId, runId) {
      return data.keys().hasAll(['runId', 'scheduleId', 'userId', 'scheduledFor', 'executedAt', 'status']) &&
        data.keys().hasOnly(['runId', 'scheduleId', 'userId', 'scheduledFor', 'executedAt', 'status', 'taskId', 'deduplicated', 'reason']) &&
        data.runId is string && isValidId(data.runId) && data.runId == runId &&
        data.scheduleId is string && isValidId(data.scheduleId) &&
        data.userId is string && data.userId == ownerId &&
        data.scheduledFor is string && data.scheduledFor.size() <= 64 &&
        data.executedAt is string && data.executedAt.size() <= 64 &&
        data.status in ['dispatched', 'skipped_condition', 'failed'];
    }

    function isValidNotification(data, ownerId, notificationId) {
      return data.keys().hasAll(['notificationId', 'userId', 'kind', 'title', 'body', 'read', 'createdAt']) &&
        data.keys().hasOnly(['notificationId', 'userId', 'kind', 'title', 'body', 'taskId', 'scheduleId', 'read', 'createdAt', 'readAt', 'metadata']) &&
        data.notificationId is string && isValidId(data.notificationId) && data.notificationId == notificationId &&
        data.userId is string && data.userId == ownerId &&
        data.kind in ['task_completed', 'task_failed', 'approval_required', 'schedule_reminder', 'schedule_executed', 'system'] &&
        data.title is string && data.title.size() <= 160 &&
        data.body is string && data.body.size() <= 1000 &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAuditLog(data, ownerId, auditId) {
      return data.keys().hasAll(['auditId', 'userId', 'action', 'resourceType', 'resourceId', 'status', 'timestamp']) &&
        data.keys().hasOnly(['auditId', 'userId', 'action', 'resourceType', 'resourceId', 'status', 'details', 'timestamp']) &&
        data.auditId is string && isValidId(data.auditId) && data.auditId == auditId &&
        data.userId is string && data.userId == ownerId &&
        data.action is string && data.action.size() <= 128 &&
        data.resourceType in ['sandbox', 'terminal', 'filesystem', 'preview', 'browser', 'permission', 'webhook'] &&
        data.resourceId is string && data.resourceId.size() <= 128 &&
        data.status in ['allowed', 'denied', 'challenged', 'succeeded', 'failed'] &&
        (!('details' in data) || (data.details is map && data.details.keys().size() <= 30)) &&
        data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidIdempotency(data, ownerId, keyId) {
      return data.keys().hasAll(['key', 'userId', 'createdAt', 'expiresAt']) &&
        data.keys().hasOnly(['key', 'userId', 'result', 'createdAt', 'expiresAt']) &&
        data.key is string && isValidId(data.key) && data.key == keyId &&
        data.userId is string && data.userId == ownerId &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.expiresAt is string && data.expiresAt.size() <= 64;
    }

    match /test/connection {
      allow get: if isSignedIn() || request.time != null;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().id == userId && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
        incoming().id == existing().id &&
        (!('createdAt' in existing()) || ('createdAt' in incoming() && incoming().createdAt == existing().createdAt));
      allow delete: if isOwner(userId) && isValidId(userId);

      match /settings/{settingsId} {
        allow get: if isOwner(userId) && isValidId(settingsId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingsId) && (
          (settingsId == 'preferences' && isValidSettings(incoming())) ||
          (settingsId == 'memories' && isValidMemories(incoming())) ||
          (settingsId == 'schedules' && isValidSchedules(incoming())) ||
          (settingsId == 'knowledge_cache' && isValidKnowledgeCache(incoming()))
        );
        allow update: if isOwner(userId) && isValidId(settingsId) && (
          (settingsId == 'preferences' && isValidSettings(incoming()) && incoming().userId == existing().userId) ||
          (settingsId == 'memories' && isValidMemories(incoming())) ||
          (settingsId == 'schedules' && isValidSchedules(incoming())) ||
          (settingsId == 'knowledge_cache' && isValidKnowledgeCache(incoming()))
        );
        allow delete: if isOwner(userId) && isValidId(settingsId);
      }

      match /checkpoints/{checkpointId} {
        allow get, list: if isOwner(userId) && isValidId(checkpointId);
        allow create: if isOwner(userId) && isValidId(checkpointId) && isValidCheckpoint(incoming(), userId, checkpointId);
        allow update: if isOwner(userId) && isValidId(checkpointId) &&
          isValidCheckpoint(incoming(), userId, checkpointId) &&
          incoming().id == existing().id && incoming().taskId == existing().taskId &&
          incoming().conversationId == existing().conversationId && incoming().userId == existing().userId &&
          isValidCheckpointTransition();
        allow delete: if isOwner(userId) && isValidId(checkpointId);
      }

      match /sandboxes/{sandboxId} {
        allow get: if isOwner(userId) && isValidId(sandboxId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sandboxId) && isValidSandbox(incoming(), userId, sandboxId);
        allow update: if isOwner(userId) && isValidId(sandboxId) &&
          isValidSandbox(incoming(), userId, sandboxId) &&
          incoming().sandboxId == existing().sandboxId &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (!(existing().status in ['stopped', 'expired']) || incoming().status == existing().status);
        allow delete: if isOwner(userId) && isValidId(sandboxId);
      }

      match /executions/{executionId} {
        allow get: if isOwner(userId) && isValidId(executionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(executionId) && isValidExecution(incoming(), userId, executionId);
        allow update: if isOwner(userId) && isValidId(executionId) &&
          isValidExecution(incoming(), userId, executionId) &&
          incoming().executionId == existing().executionId &&
          incoming().sandboxId == existing().sandboxId &&
          incoming().userId == existing().userId &&
          incoming().startedAt == existing().startedAt;
        allow delete: if false;
      }

      match /browser_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidBrowserSession(incoming(), userId, sessionId);
        allow update: if isOwner(userId) && isValidId(sessionId) &&
          isValidBrowserSession(incoming(), userId, sessionId) &&
          incoming().sessionId == existing().sessionId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (!(existing().status in ['closed', 'expired']) || incoming().status == existing().status);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /approvals/{challengeId} {
        allow get: if isOwner(userId) && isValidId(challengeId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(challengeId) && isValidApproval(incoming(), userId, challengeId);
        allow update: if isOwner(userId) && isValidId(challengeId) &&
          isValidApproval(incoming(), userId, challengeId) &&
          incoming().challengeId == existing().challengeId &&
          incoming().parametersHash == existing().parametersHash &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (!(existing().status in ['consumed', 'rejected', 'expired']) || incoming().status == existing().status);
        allow delete: if false;
      }

      match /audit_logs/{auditId} {
        allow get: if isOwner(userId) && isValidId(auditId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(auditId) && isValidAuditLog(incoming(), userId, auditId);
        allow update, delete: if false;
      }

      match /idempotency/{keyId} {
        allow get: if isOwner(userId) && isValidId(keyId);
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(keyId) && isValidIdempotency(incoming(), userId, keyId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(keyId);
      }

      match /permission_policies/{policyId} {
        allow get: if isOwner(userId) && isValidId(policyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(policyId) && isValidPermissionPolicy(incoming(), userId, policyId);
        allow update: if isOwner(userId) && isValidId(policyId) &&
          isValidPermissionPolicy(incoming(), userId, policyId) &&
          incoming().policyId == existing().policyId &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(policyId);
      }

      match /background_tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidBackgroundTask(incoming(), userId, taskId);
        allow update: if isOwner(userId) && isValidId(taskId) &&
          isValidBackgroundTask(incoming(), userId, taskId) &&
          incoming().taskId == existing().taskId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if false;
      }

      match /multi_agent_runs/{runId} {
        allow get: if isOwner(userId) && isValidId(runId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(runId) && isValidMultiAgentRun(incoming(), userId, runId);
        allow update: if isOwner(userId) && isValidId(runId) &&
          isValidMultiAgentRun(incoming(), userId, runId) &&
          incoming().runId == existing().runId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if false;
      }

      match /skills/{skillId} {
        allow get: if isOwner(userId) && isValidId(skillId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(skillId) && isValidInstalledSkill(incoming(), userId, skillId);
        allow update: if isOwner(userId) && isValidId(skillId) &&
          isValidInstalledSkill(incoming(), userId, skillId) &&
          incoming().skillId == existing().skillId &&
          incoming().userId == existing().userId &&
          incoming().installedAt == existing().installedAt;
        allow delete: if isOwner(userId) && isValidId(skillId);
      }

      match /skill_executions/{executionId} {
        allow get: if isOwner(userId) && isValidId(executionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(executionId) && isValidSkillExecution(incoming(), userId, executionId);
        allow update, delete: if false;
      }

      match /schedules/{scheduleId} {
        allow get: if isOwner(userId) && isValidId(scheduleId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(scheduleId) && isValidSchedule(incoming(), userId, scheduleId);
        allow update: if isOwner(userId) && isValidId(scheduleId) &&
          isValidSchedule(incoming(), userId, scheduleId) &&
          incoming().scheduleId == existing().scheduleId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (existing().status != 'cancelled' || incoming().status == 'cancelled');
        allow delete: if isOwner(userId) && isValidId(scheduleId);
      }

      match /schedule_runs/{runId} {
        allow get: if isOwner(userId) && isValidId(runId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(runId) && isValidScheduleRun(incoming(), userId, runId);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(notificationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming(), userId, notificationId);
        allow update: if isOwner(userId) && isValidId(notificationId) &&
          isValidNotification(incoming(), userId, notificationId) &&
          incoming().notificationId == existing().notificationId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(notificationId);
      }
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && incoming().id == projectId && incoming().userId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid &&
        incoming().id == existing().id && incoming().id == projectId && incoming().userId == existing().userId &&
        incoming().created_at == existing().created_at && isValidProject(incoming());
      allow delete: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(conversationId) && incoming().id == conversationId && incoming().userId == request.auth.uid && isValidConversation(incoming());
      allow update: if isSignedIn() && isValidId(conversationId) && existing().userId == request.auth.uid &&
        incoming().id == conversationId && isValidConversationUpdate();
      allow delete: if isSignedIn() && isValidId(conversationId) && existing().userId == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(messageId) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status != 'completed' && incoming().id == messageId && incoming().conversationId == conversationId && incoming().userId == request.auth.uid && isValidMessage(incoming());
        allow update: if isSignedIn() && isValidId(messageId) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status != 'completed' && existing().id == messageId && existing().conversationId == conversationId && incoming().id == existing().id && incoming().conversationId == existing().conversationId && existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().timestamp == existing().timestamp && isValidMessage(incoming());
        allow delete: if isSignedIn() && isValidId(messageId) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
      }
    }
  }
}
