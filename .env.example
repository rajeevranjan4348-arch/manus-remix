VITE_BLINK_PROJECT_ID=
VITE_BLINK_PUBLISHABLE_KEY=

# Manus Remix public API endpoint overrides (optional; defaults are built in)
VITE_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
VITE_REST_COUNTRIES_URL=https://restcountries.com/v3.1
VITE_WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1
VITE_WIKIPEDIA_SEARCH_API_URL=https://en.wikipedia.org/w/rest.php/v1/search/page
VITE_OPEN_LIBRARY_URL=https://openlibrary.org
VITE_NAGER_DATE_URL=https://date.nager.at/api/v3
VITE_USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
VITE_GITHUB_API_URL=https://api.github.com

# GitHub connector server secrets (configure in Netlify Site configuration > Environment variables).
# Never prefix these with VITE_ or commit real credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Security: VITE_* values are public in the browser bundle. Never put private
# API keys, GitHub tokens, passwords, or other secrets in VITE_* variables.
# The selected public endpoints above do not require keys for standard public use.
