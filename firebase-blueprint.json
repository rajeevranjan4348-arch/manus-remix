{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID matching auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Email address of user",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Display name of user",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL of user",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "email"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Preferences and configuration for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID matching auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "description": "Active UI theme",
          "enum": ["light", "dark", "system"]
        },
        "defaultMode": {
          "type": "string",
          "description": "Default execution mode",
          "enum": ["chat", "work"]
        },
        "language": {
          "type": "string",
          "description": "Application display language",
          "maxLength": 10
        },
        "defaultModel": {
          "type": "string",
          "description": "Default AI model identifier",
          "maxLength": 64
        },
        "voicePersona": {
          "type": "string",
          "description": "Preferred voice persona",
          "enum": ["alloy", "echo", "fable", "onyx", "nova", "shimmer", "marcus", "tintin", "guy"]
        },
        "updatedAt": {
          "type": "string",
          "description": "Last settings update timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId", "theme"]
    },
    "UserMemories": {
      "title": "UserMemories",
      "description": "Long-term memories and facts for a user",
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "description": "List of memory records"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      }
    },
    "KnowledgeCache": {
      "title": "KnowledgeCache",
      "description": "Verified real-time intelligence records, source metadata, and user research history",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "description": "List of verified knowledge records with freshness timestamps"
        },
        "history": {
          "type": "array",
          "description": "User research query history"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      }
    },
    "Project": {
      "title": "Project",
      "description": "Organizational container for agent tasks and sessions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Project title",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "Project description",
          "maxLength": 1000
        },
        "icon": {
          "type": "string",
          "description": "Project icon identifier",
          "maxLength": 64
        },
        "color": {
          "type": "string",
          "description": "Project color accent",
          "maxLength": 64
        },
        "customInstructions": {
          "type": "string",
          "description": "Custom prompt instructions for the project",
          "maxLength": 10000
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        },
        "updated_at": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "name", "created_at", "updated_at"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Autonomous task and chat conversation session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Conversation topic title",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        },
        "mode": {
          "type": "string",
          "description": "Execution mode",
          "enum": ["chat", "work"]
        },
        "outputFormat": {
          "type": "string",
          "description": "Requested output format",
          "maxLength": 64
        },
        "chartType": {
          "type": "string",
          "description": "Requested chart type",
          "maxLength": 64
        },
        "projectId": {
          "type": "string",
          "description": "Associated project ID if assigned",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Execution status",
          "enum": ["idle", "running", "completed", "error"]
        },
        "result": {
          "type": "string",
          "description": "Serialized execution result or summary",
          "maxLength": 500000
        },
        "prompt": {
          "type": "string",
          "description": "Initial task prompt",
          "maxLength": 10000
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt", "mode", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Sender user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Role of the author",
          "enum": ["user", "assistant", "system"]
        },
        "content": {
          "type": "string",
          "description": "Message body content",
          "maxLength": 500000
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Delivery / execution state",
          "enum": ["pending", "success", "failed", "streaming"]
        }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "timestamp", "status"]
    },
    "TaskCheckpoint": {
      "title": "TaskCheckpoint",
      "description": "Periodic auto-saved execution checkpoint for active tasks to prevent data loss on unexpected browser tab close",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable checkpoint identifier (chk_<taskId>)",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskId": {
          "type": "string",
          "description": "Active task identifier matching the checkpoint document ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "description": "Associated conversation identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "stepIndex": {
          "type": "integer",
          "description": "Zero-based index of the active or most recently completed step"
        },
        "totalSteps": {
          "type": "integer",
          "description": "Total number of planned workflow steps"
        },
        "stepLabel": {
          "type": "string",
          "description": "Human-readable label for the current execution step",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "description": "Execution checkpoint lifecycle status",
          "enum": ["in_progress", "completed", "interrupted", "failed"]
        },
        "completedToolCalls": {
          "type": "array",
          "description": "Bounded list (max 100) of completed tool or step execution summaries"
        },
        "accumulatedResult": {
          "type": "string",
          "description": "Accumulated partial or final streamed task response text",
          "maxLength": 500000
        },
        "stateSnapshot": {
          "type": "object",
          "description": "Compact key-value map (max 100 keys) of active task metadata, steps, and auto-save sequence"
        },
        "checksum": {
          "type": "string",
          "description": "Deterministic integrity checksum for recovery validation",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the last auto-save write",
          "maxLength": 64
        },
        "resumedAt": {
          "type": "string",
          "description": "Optional ISO timestamp when checkpoint was resumed",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "taskId",
        "conversationId",
        "userId",
        "stepIndex",
        "stepLabel",
        "completedToolCalls",
        "accumulatedResult",
        "checksum",
        "timestamp"
      ]
    },
    "SandboxWorkspace": {
      "title": "SandboxWorkspace",
      "description": "Isolated per-user coding sandbox workspace metadata and lifecycle record",
      "type": "object",
      "properties": {
        "sandboxId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provider": { "type": "string", "enum": ["e2b", "daytona", "http-runtime", "unconfigured"] },
        "providerSandboxId": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "taskId": { "type": "string", "maxLength": 128 },
        "runtime": { "type": "string", "enum": ["node", "typescript", "javascript", "python", "html", "react", "vite", "nextjs", "custom"] },
        "image": { "type": "string", "maxLength": 256 },
        "workspaceRoot": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["creating", "running", "idle", "stopping", "stopped", "expired", "error"] },
        "limits": { "type": "object" },
        "persistent": { "type": "boolean" },
        "previewUrl": { "type": "string", "maxLength": 1024 },
        "previewPort": { "type": "integer" },
        "previewStatus": { "type": "string", "enum": ["stopped", "starting", "ready", "failed"] },
        "previewCommandExecutionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "cleanedUpAt": { "type": "string", "maxLength": 64 },
        "error": { "type": "string", "maxLength": 2000 }
      },
      "required": ["sandboxId", "workspaceId", "provider", "providerSandboxId", "userId", "projectId", "runtime", "workspaceRoot", "status", "createdAt", "updatedAt", "expiresAt"]
    },
    "TerminalExecution": {
      "title": "TerminalExecution",
      "description": "Durable isolated terminal command execution record with separated stdout/stderr and exit code",
      "type": "object",
      "properties": {
        "executionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sandboxId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provider": { "type": "string", "enum": ["e2b", "daytona", "http-runtime", "unconfigured"] },
        "providerExecutionId": { "type": "string", "maxLength": 256 },
        "command": { "type": "string", "maxLength": 4096 },
        "cwd": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed", "timed_out", "cancelled"] },
        "stdout": { "type": "string", "maxLength": 250000 },
        "stderr": { "type": "string", "maxLength": 250000 },
        "exitCode": { "type": "integer" },
        "startedAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "durationMs": { "type": "integer" },
        "timeoutMs": { "type": "integer" },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "retryCount": { "type": "integer" },
        "cancelled": { "type": "boolean" },
        "error": { "type": "string", "maxLength": 2000 },
        "untrustedData": { "type": "boolean" }
      },
      "required": ["executionId", "sandboxId", "workspaceId", "userId", "provider", "command", "cwd", "status", "startedAt", "timeoutMs", "retryCount", "untrustedData"]
    },
    "BrowserSession": {
      "title": "BrowserSession",
      "description": "Isolated remote browser session state and lifecycle record",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provider": { "type": "string", "enum": ["browserless", "browserbase", "http-browser", "unconfigured"] },
        "providerSessionId": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["creating", "active", "closed", "expired", "error"] },
        "currentUrl": { "type": "string", "maxLength": 2048 },
        "currentTitle": { "type": "string", "maxLength": 300 },
        "viewport": { "type": "object" },
        "isolatedStorage": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "closedAt": { "type": "string", "maxLength": 64 },
        "error": { "type": "string", "maxLength": 2000 }
      },
      "required": ["sessionId", "provider", "providerSessionId", "userId", "status", "isolatedStorage", "createdAt", "updatedAt", "expiresAt"]
    },
    "PermissionApproval": {
      "title": "PermissionApproval",
      "description": "Durable single-use permission challenge and confirmation record",
      "type": "object",
      "properties": {
        "challengeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toolName": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 256 },
        "riskLevel": { "type": "string", "enum": ["read-only", "destructive", "privileged"] },
        "target": { "type": "string", "maxLength": 512 },
        "parametersHash": { "type": "string", "maxLength": 128 },
        "parametersSummary": { "type": "object" },
        "consequences": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired", "consumed", "revoked"] },
        "approvalToken": { "type": "string", "maxLength": 128 },
        "resolvedAt": { "type": "integer" },
        "revokedAt": { "type": "integer" },
        "revocationReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["challengeId", "toolName", "riskLevel", "parametersHash", "userId", "createdAt", "expiresAt", "status"]
    },
    "PermissionPolicy": {
      "title": "PermissionPolicy",
      "description": "User-specific tool permission policy override",
      "type": "object",
      "properties": {
        "policyId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toolName": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["default", "always_require_approval", "auto_allow_non_destructive", "deny"] },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 300 }
      },
      "required": ["policyId", "userId", "toolName", "mode", "updatedAt", "updatedBy"]
    },
    "BackgroundTask": {
      "title": "BackgroundTask",
      "description": "Feature 01 durable cloud background task record with lease, retries, and execution history",
      "type": "object",
      "properties": {
        "taskId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["research", "coding", "automation", "multi_agent", "scheduled", "skill", "general"] },
        "title": { "type": "string", "maxLength": 180 },
        "prompt": { "type": "string", "maxLength": 20000 },
        "status": { "type": "string", "enum": ["queued", "claimed", "running", "completed", "failed", "cancelled", "dead_letter"] },
        "phase": { "type": "string", "maxLength": 64 },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "priorityScore": { "type": "integer" },
        "progress": { "type": "integer" },
        "attempt": { "type": "integer" },
        "maxAttempts": { "type": "integer" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["taskId", "userId", "type", "title", "prompt", "status", "phase", "priority", "attempt", "maxAttempts", "createdAt", "updatedAt"]
    },
    "MultiAgentRun": {
      "title": "MultiAgentRun",
      "description": "Feature 03 durable multi-agent DAG execution run record",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "objective": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["running", "completed", "failed", "cancelled"] },
        "provider": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["runId", "userId", "objective", "status", "provider", "createdAt", "updatedAt"]
    },
    "InstalledSkill": {
      "title": "InstalledSkill",
      "description": "Feature 04 server-backed installed skill manifest and version history",
      "type": "object",
      "properties": {
        "skillId": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9_\\-]+$" },
