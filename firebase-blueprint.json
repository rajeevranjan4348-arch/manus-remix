        "name": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 32 },
        "executionType": { "type": "string", "enum": ["declarative", "tool_workflow", "sandbox_code"] },
        "trustTier": { "type": "string", "enum": ["verified_builtin", "third_party"] },
        "integrityHash": { "type": "string", "maxLength": 128 },
        "enabled": { "type": "boolean" },
        "installedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["skillId", "userId", "name", "version", "executionType", "trustTier", "integrityHash", "enabled", "installedAt", "updatedAt"]
    },
    "SkillExecution": {
      "title": "SkillExecution",
      "description": "Feature 04 append-only skill execution history record",
      "type": "object",
      "properties": {
        "executionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "skillId": { "type": "string", "maxLength": 64 },
        "skillVersion": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["succeeded", "failed", "denied"] },
        "startedAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["executionId", "userId", "skillId", "skillVersion", "status", "startedAt", "completedAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Feature 05 persistent cron/timezone automation schedule",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 160 },
        "kind": { "type": "string", "enum": ["once", "interval", "daily", "weekly", "monthly", "cron"] },
        "status": { "type": "string", "enum": ["active", "paused", "completed", "cancelled"] },
        "timeZone": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["scheduleId", "userId", "name", "kind", "status", "timeZone", "createdAt", "updatedAt"]
    },
    "ScheduleRun": {
      "title": "ScheduleRun",
      "description": "Feature 05 append-only schedule execution history record",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scheduleId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "executedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["dispatched", "skipped_condition", "failed"] }
      },
      "required": ["runId", "scheduleId", "userId", "scheduledFor", "executedAt", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Durable user notification for task completions, approvals, and scheduled runs",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
